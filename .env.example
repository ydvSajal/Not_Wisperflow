# WhisprFlow needs NO environment variables to run in local mode.
# Cloud transcription and AI cleanup keys are entered in the app's Settings UI
# and stored in the OS user-data folder (settings.json), never in this repo.
#
# The variables below are optional overrides for development only.

# Override where Whisper ONNX models are cached (default: <userData>/models)
# WHISPRFLOW_MODEL_DIR=

# Skip auto-registering the global hotkey on launch (useful in CI/headless)
# WHISPRFLOW_NO_HOTKEY=1
